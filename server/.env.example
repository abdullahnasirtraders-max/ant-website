# ---- Server ----
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (include a database name, e.g. /ant-store)
MONGODB_URI=mongodb://127.0.0.1:27017/ant-store
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
# Comma-separated list of browser origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the frontend (used in sitemap.xml)
SITE_URL=http://localhost:5173
# lax works when the frontend proxies /api (recommended, see README). Use "none" only for direct cross-site calls.
COOKIE_SAMESITE=lax

# ---- First admin account (created by `npm run seed`) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ---- Cloudinary (image uploads in admin). Optional in dev: admin can paste image URLs instead ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Online payments (leave empty to disable; COD always works) ----
# Set to the key of a provider registered in server/src/services/payments/index.js
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
